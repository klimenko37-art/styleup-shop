<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>STYLEUP — Магазин одягу</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#f8f6f2;color:#29251f;font-family:Arial,sans-serif}
header{background:#29251f;color:white;padding:22px 16px;text-align:center}
header h1{font-size:34px;letter-spacing:4px;margin:0}
header p{color:#ded4c7}
nav{background:#e9e1d7;padding:15px;text-align:center;position:sticky;top:0}
nav a{color:#29251f;text-decoration:none;font-weight:bold;margin:0 10px;font-size:14px}
.hero{padding:38px 20px;text-align:center;background:#ddd0c0}
.hero h2{font-size:30px;margin:5px}
.hero p{line-height:1.6}
button{background:#29251f;color:white;border:0;padding:12px 16px;border-radius:5px;cursor:pointer}
main{padding:20px 12px;max-width:1000px;margin:auto}
h2{text-align:center}
.tools{text-align:center;margin:20px 0}
input{padding:12px;border:1px solid #ccc;border-radius:5px;max-width:100%;margin:5px}
.filters{display:flex;gap:7px;justify-content:center;flex-wrap:wrap;margin:15px 0}
.filters button{padding:10px 12px}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.card{background:white;border-radius:9px;overflow:hidden;padding-bottom:14px;text-align:center;box-shadow:0 2px 8px #0000000c}
.card img{width:100%;aspect-ratio:4/4;object-fit:cover;background:#eee}
.card h3{font-size:16px;margin:12px 4px 6px}
.price{font-weight:bold;margin:8px}
.card button{padding:10px 12px}
#cart{background:white;padding:18px;border-radius:8px;margin-top:28px}
#contacts{text-align:center;padding:25px 10px}
footer{background:#29251f;color:white;text-align:center;padding:24px;line-height:1.7}
@media(min-width:650px){.grid{grid-template-columns:repeat(4,minmax(0,1fr))}.hero h2{font-size:42px}}
</style>
</head>
<body>
<header><h1>STYLEUP</h1><p>Твій стиль — твій вибір!</p></header>
<nav><a href="#home">Головна</a><a href="#shop">Каталог</a><a href="#cart">Кошик</a><a href="#contacts">Контакти</a></nav>
<section class="hero" id="home"><p>НОВА КОЛЕКЦІЯ</p><h2>Знайди свій стиль</h2><p>Одяг та взуття на кожен день</p><a href="#shop"><button>Переглянути товари</button></a></section>
<main>
<h2 id="shop">Наш каталог</h2>
<div class="tools"><input id="search" placeholder="🔍 Знайти товар..." oninput="render()"></div>
<div class="filters"><button onclick="category='Усі';render()">Усі</button><button onclick="category='Взуття';render()">Взуття</button><button onclick="category='Одяг';render()">Одяг</button></div>
<div class="grid" id="products"></div>
<section id="cart"><h2>🛍️ Мій кошик</h2><div id="cartitems">Поки що кошик порожній</div><p id="total">Разом: 0 грн</p><button onclick="checkout()">Оформити замовлення</button></section>
<section id="contacts"><h2>Зв'язатися з нами</h2><p>Маєш питання? Напиши нам!</p><input id="name" placeholder="Твоє ім'я"><br><input id="email" type="email" placeholder="Твій email"><br><button onclick="contact()">Надіслати</button></section>
</main>
<footer><b>STYLEUP</b><p>Твій стиль — твій вибір!</p><p>© 2026 STYLEUP</p></footer>
<script>
const products=[
{name:'Кросівки',price:1999,cat:'Взуття',img:'https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=600&q=80'},
{name:'Білі кросівки',price:2199,cat:'Взуття',img:'https://images.unsplash.com/photo-1549298916-b41d501d3772?auto=format&fit=crop&w=600&q=80'},
{name:'Футболка',price:599,cat:'Одяг',img:'https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=600&q=80'},
{name:'Худі',price:1299,cat:'Одяг',img:'https://images.unsplash.com/photo-1556821840-3a63f95609a7?auto=format&fit=crop&w=600&q=80'},
{name:'Джинси',price:1499,cat:'Одяг',img:'https://images.unsplash.com/photo-1542272604-787c3835535d?auto=format&fit=crop&w=600&q=80'},
{name:'Куртка',price:2499,cat:'Одяг',img:'https://images.unsplash.com/photo-1544923246-77307dd654cb?auto=format&fit=crop&w=600&q=80'},
{name:'Спортивне взуття',price:1799,cat:'Взуття',img:'https://images.unsplash.com/photo-1460353581641-37baddab0fa2?auto=format&fit=crop&w=600&q=80'},
{name:'Сорочка',price:899,cat:'Одяг',img:'https://images.unsplash.com/photo-1598033129183-c4f50c736f10?auto=format&fit=crop&w=600&q=80'}
];
let category='Усі',cart=[];
function render(){
let q=document.getElementById('search').value.toLowerCase();
document.getElementById('products').innerHTML=products.filter(p=>(category==='Усі'||p.cat===category)&&p.name.toLowerCase().includes(q)).map(p=>'<article class="card"><img src="'+p.img+'" alt="'+p.name+'"><h3>'+p.name+'</h3><p class="price">'+p.price+' грн</p><button onclick="add('+products.indexOf(p)+')">До кошика</button></article>').join('');
}
function add(i){cart.push(products[i]);showCart();alert('Додано в кошик: '+products[i].name)}
function showCart(){document.getElementById('cartitems').innerHTML=cart.length?cart.map((p,i)=>p.name+' — '+p.price+' грн <button onclick="removeItem('+i+')">Видалити</button>').join('<hr>'):'Поки що кошик порожній';document.getElementById('total').textContent='Разом: '+cart.reduce((s,p)=>s+p.price,0)+' грн'}
function removeItem(i){cart.splice(i,1);showCart()}
function checkout(){alert(cart.length?'Це навчальний магазин. Для справжнього замовлення потрібна система оформлення.':'Спочатку додай товар у кошик!')}
function contact(){let n=document.getElementById('name').value.trim(),e=document.getElementById('email').value.trim();if(!n||!e){alert('Заповни ім’я та email!')}else{alert('Дякуємо, '+n+'! Це демонстраційна форма, повідомлення не надсилається.');}}
render();
</script>
</body>
</html>
